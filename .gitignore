# ===========================================================================
# Repo root .gitignore
#
# The Unity project lives in FPS/, which has its own .gitignore (based on
# https://github.com/github/gitignore/blob/main/Unity.gitignore) holding all
# project paths: Library/, Temp/, Logs/, obj/, UserSettings/, Build/,
# .codely-cli/, screenshots/, generated *.csproj/*.sln, ... - see FPS/.gitignore
#
# This file only holds rules that apply to the repository as a whole.
# ===========================================================================

# --- OS junk (github/gitignore Global templates) ---------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
*~
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editor / tool caches --------------------------------------------------
.idea/
.vscode/
*.log
*.tmp
